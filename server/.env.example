# Copia este archivo como .env dentro de server/ para desarrollo local con Turso.
# Si dejas estas dos variables vacías, el servidor usa automáticamente un
# archivo SQLite local (coleccion.local.db) en vez de Turso — útil para
# programar sin depender de la nube.

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Puerto en el que arranca la API (Render lo define solo en producción).
PORT=3001

# Login de la app. Si dejas AUTH_PASSWORD vacío, el login queda desactivado
# (cualquiera puede entrar sin usuario/contraseña) — útil en local, pero
# ponlo SIEMPRE en producción (Render) para que tu colección no quede pública.
AUTH_USERNAME=admin
AUTH_PASSWORD=
# Cadena aleatoria larga usada para firmar la sesión. Genera una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
