# Copia este archivo como .env dentro de server/ para desarrollo local con Turso.
# Si dejas estas dos variables vacías, el servidor usa automáticamente un
# archivo SQLite local (coleccion.local.db) en vez de Turso — útil para
# programar sin depender de la nube.

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Puerto en el que arranca la API (Render lo define solo en producción).
PORT=3001
